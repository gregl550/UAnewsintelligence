# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Gmail SMTP (use an App Password, not your account password)
# Enable 2FA at myaccount.google.com, then create App Password at:
# myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Who receives the briefing (comma-separated for multiple)
RECIPIENT_EMAILS=you@gmail.com

# Optional: override the sender display name
SENDER_NAME=Universal Ads Intelligence
